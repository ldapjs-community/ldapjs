{
  "originalAuthor": "Mark Cavage <mcavage@gmail.com>",
  "name": "ldapjs-community",
  "homepage": "",
  "description": "LDAP client and server APIs",
  "version": "2.3.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldapjs-community/ldapjs.git"
  },
  "main": "lib/index.js",
  "directories": {
    "lib": "./lib"
  },
  "engines": {
    "node": ">=10.13.0"
  },
  "dependencies": {
    "abstract-logging": "^2.0.0",
    "asn1": "^0.2.4",
    "assert-plus": "^1.0.0",
    "backoff": "^2.5.0",
    "ldap-filter": "^0.3.3",
    "once": "^1.4.0",
    "vasync": "^2.2.0",
    "verror": "^1.8.1"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "front-matter": "^4.0.2",
    "get-port": "^5.1.1",
    "highlight.js": "^11.0.1",
    "marked": "^4.0.0",
    "neostandard": "0.12.2",
    "tap": "20.0.3"
  },
  "overrides": {
    "@tapjs/processinfo": {
      "uuid": "11.1.0"
    }
  },
  "scripts": {
    "test": "tap --disable-coverage -R terse",
    "test:ci": "tap --allow-incomplete-coverage -R terse && tap report lcovonly",
    "test:cov": "tap --allow-incomplete-coverage -R terse",
    "test:cov:html": "tap --allow-incomplete-coverage -R terse && tap report html --no-browser",
    "test:watch": "tap -n -w --disable-coverage -R terse",
    "test:integration": "tap --disable-coverage -R terse 'test-integration/**/*.test.js'",
    "test:integration:local": "docker-compose up -d && npm run test:integration && docker-compose down",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "docs": "node scripts/build-docs.js"
  }
}
